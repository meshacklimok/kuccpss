# Copy this file to .env and fill in your values

# Django
SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# PostgreSQL
DB_NAME=kuccpss
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
# Render / production — overrides individual DB_* vars above if set
DATABASE_URL=

# IntaSend M-Pesa (get keys from intasend.com → Settings → API Keys)
INTASEND_PUBLISHABLE_KEY=ISPubKey_live_xxxxxxxxxxxxxxxxxxxx
INTASEND_SECRET_KEY=ISSecretKey_live_xxxxxxxxxxxxxxxxxxxx
INTASEND_WEBHOOK_SECRET=your-webhook-secret
INTASEND_SANDBOX=false

# Cloudinary media storage (format: cloudinary://key:secret@cloud)
CLOUDINARY_URL=

# Google OAuth (build.sh creates/updates the DB SocialApp from these)
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# Transactional email (Resend SMTP)
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=CareerNext <noreply@careernext.co.ke>

# Web Push (VAPID) — optional
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=support@careernext.co.ke

# Analytics & Monitoring
POSTHOG_API_KEY=phc_xxxxxxxxxxxx
POSTHOG_HOST=https://eu.i.posthog.com
# Optional: PostHog Dashboard → Share → Embed → copy iframe src
POSTHOG_EMBED_URL=

SENTRY_DSN=https://xxx@oXXXXXX.ingest.sentry.io/XXXXXXX

GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Optional: Looker Studio embedded report URL for admin iframe
GA_EMBED_URL=
