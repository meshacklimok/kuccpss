# Copy this file to .env and fill in your values

# Django
SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
# In-process scheduler (kuccpss/scheduler.py): pending-payment recovery + mentorship
# reminders/auto-complete every 10 min. Defaults to on when DEBUG is off.
BACKGROUND_JOBS_ENABLED=True
# Pinged every 10 min to stop a sleeping host; leave unset on the Droplet
# KEEPALIVE_URL=https://www.careernext.co.ke

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# PostgreSQL
DB_NAME=kuccpss
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
# Production — overrides individual DB_* vars above if set
DATABASE_URL=

# IntaSend M-Pesa (get keys from intasend.com → Settings → API Keys)
INTASEND_PUBLISHABLE_KEY=ISPubKey_live_xxxxxxxxxxxxxxxxxxxx
INTASEND_SECRET_KEY=ISSecretKey_live_xxxxxxxxxxxxxxxxxxxx
INTASEND_WEBHOOK_SECRET=your-webhook-secret
INTASEND_SANDBOX=false

# Safaricom Daraja Paybill (developer.safaricom.co.ke). Switch it on in admin →
# Payment Gateway Settings once these are filled in.
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_SECRET=long-random-string-used-in-the-callback-url
DARAJA_SITE_URL=https://www.careernext.co.ke
DARAJA_SANDBOX=false

# Cloudinary media storage (format: cloudinary://key:secret@cloud)
CLOUDINARY_URL=

# Google OAuth (build.sh creates/updates the DB SocialApp from these)
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# Transactional email (Resend SMTP)
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=CareerNext <noreply@careernext.co.ke>

# Web Push (VAPID) — optional
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=support@careernext.co.ke

# Analytics & Monitoring
POSTHOG_API_KEY=phc_xxxxxxxxxxxx
POSTHOG_HOST=https://eu.i.posthog.com
# Optional: PostHog Dashboard → Share → Embed → copy iframe src
POSTHOG_EMBED_URL=

SENTRY_DSN=https://xxx@oXXXXXX.ingest.sentry.io/XXXXXXX

GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Optional: Looker Studio embedded report URL for admin iframe
GA_EMBED_URL=

# ── Maintenance mode ──────────────────────────────────────────────────────────
# Set MAINTENANCE_MODE=True to show visitors a 503 "back soon" page.
# Staff logins, /cn-staff/, /health/ and /robots.txt still work.
MAINTENANCE_MODE=False
MAINTENANCE_MESSAGE=We're carrying out scheduled upgrades to CareerNext. Your saved KCSE results and shortlist are safe.
# Free text shown to visitors, e.g. "Today at 6:00 PM EAT". Leave blank to hide.
MAINTENANCE_UNTIL=
MAINTENANCE_RETRY_AFTER=3600
# Comma-separated IPs that bypass maintenance mode (your own IP, testers)
MAINTENANCE_ALLOWED_IPS=

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres on the DigitalOcean Droplet (direct, local connection).
DATABASE_URL=postgresql://kuccpss:password@127.0.0.1:5432/kuccpss
# Override connection lifetime if needed (default: 0 pooled, 600 direct)
DB_CONN_MAX_AGE=
